# Configuración de Base de Datos
# Copia este archivo a .env y personaliza según tus necesidades

# Nombre del contenedor Docker
CONTAINER_NAME=mysql_uasd

# Credenciales de MySQL
DB_ROOT_PASSWORD=P@ssw0rd1234
DB_NAME=DBNomina
DB_USER=root

# Puerto MySQL
DB_PORT=3306

# Script maestro (nombre del archivo SQL)
SCRIPT_MAESTRO=Marlenis-Concepcion-INF8236-Tarea-5.1-Script-Maestro.sql

# Tiempo de espera para MySQL startup (segundos)
STARTUP_WAIT=20
